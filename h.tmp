nt-sans text-lg font-medium">Guest Videos</div></div></a><a class="group relative isolate grid rounded-md text-black no-underline outline-none hocus:scale-102 grid-cols-1 content-start gap-4 text-center text-balance" aria-label="Explore topic &quot;Talks&quot;" href="/?topic=talks" target="" data-discover="true"><div class="absolute -inset-2 -z-10 rounded-md change-ring transition group-hocus:bg-theme/15 group-hocus:outline-theme"></div><img src="/assets/talks-DxOauWJs.webp" alt=""/><div class="flex flex-col gap-2 items-center"><div class="flex items-center gap-2 font-sans text-lg font-medium">Talks</div></div></a><a class="group relative isolate grid rounded-md text-black no-underline outline-none hocus:scale-102 grid-cols-1 content-start gap-4 text-center text-balance" aria-label="Explore topic &quot;On other channels&quot;" href="/?topic=videos-elsewhere" target="" data-discover="true"><div class="absolute -inset-2 -z-10 rounded-md change-ring transition group-hocus:bg-theme/15 group-hocus:outline-theme"></div><img src="data:image/webp;base64," alt=""/><div class="flex flex-col gap-2 items-center"><div class="flex items-center gap-2 font-sans text-lg font-medium">On other channels</div></div></a></div></section><section class="items-center bg-theme/15"><h2 id="patreon"><a class="contents text-current no-underline" href="/#patreon" target="" data-discover="true"><hr/><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="icon"><path d="M187.37,32c-18.79-7.68-41.14-9.92-62.93-6.3-23.44,3.9-43.73,14-58.68,29.2-11.12,11.32-24.62,33.35-25.7,74-.7,26.49,4.39,55.44,13.61,77.45S74.61,240,87.52,240c22.94,0,33.23-20.08,43.17-39.5,7-13.6,14.16-27.66,25.55-35.38h0c5.86-4,13.8-7,22.21-10.28,23.86-9.2,53.55-20.66,53.55-61.67C232,65.9,215.73,43.6,187.37,32ZM172.69,139.91c-9.28,3.58-18.05,7-25.43,12-14.78,10-23.3,26.66-30.81,41.33C106.67,212.3,100.05,224,87.52,224c-4.52,0-12.18-7.37-19.09-23.85-8.39-20-13-46.49-12.37-70.83.73-27.66,8.23-50.11,21.11-63.21C95.23,47.74,120.79,40,144.57,40a98.48,98.48,0,0,1,36.74,6.76c13,5.3,34.69,18.38,34.69,46.37C216,123.21,195.93,131,172.69,139.91Z"></path></svg>Patreon<hr/></a></h2><div class="grid w-full grid-cols-2 items-center justify-center justify-items-center gap-x-12 gap-y-8 max-md:grid-cols-1"><p>If these lessons bring you value comparable to that of a textbook or a course, it would mean a lot to me and the rest of the team if you considered joining as a supporter.</p><p>Supporters get early access to new videos and provide essential feedback to refine their final form. Other perks include a meaningful store discount and having your name in a video.</p><img src="/assets/support-BRW9qZm8.png" alt="Image" tabindex="0" aria-label="View image in fullscreen" class="cursor-pointer break-inside-avoid w-50"/><div class="flex flex-col items-center gap-3 self-center"><a href="https://members.3blue1brown.com/" target="_blank" class="inline-flex max-w-full items-center justify-center gap-2 rounded-md font-sans text-balance no-underline [&amp;_p]:contents [&amp;_p]:leading-normal bg-theme text-white change-ring hocus:bg-black hocus:outline-black min-h-12 min-w-12 p-3 text-lg"><span class="trim">Become a Supporter</span><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="icon"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></a><a href="https://members.3blue1brown.com/posts/158885046" target="_blank" class="inline-flex max-w-full items-center justify-center gap-2 rounded-md font-sans text-balance no-underline [&amp;_p]:contents [&amp;_p]:leading-normal bg-theme/15 text-black hocus:bg-theme hocus:text-white min-h-12 min-w-12 p-3 text-lg"><span class="trim">New Video (Early Access)</span><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="icon"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></a></div></div></section><section class="dark items-center width-sm"><canvas aria-hidden="true" class="absolute inset-0 -z-10 size-full vignette"></canvas><h1 id="3b1b-talent"><a class="contents text-current no-underline" href="/#3b1b-talent" target="" data-discover="true">3b1b Talent</a></h1><p>Think of it as a <strong>virtual career fair.</strong> We partner with organizations interested in hiring the kinds of technically curious people who watch 3Blue1Brown.</p><a class="inline-flex max-w-full items-center justify-center gap-2 rounded-md font-sans text-balance no-underline [&amp;_p]:contents [&amp;_p]:leading-normal bg-black text-white change-ring hocus:bg-theme hocus:outline-theme min-h-12 min-w-12 p-3 text-lg" href="/talent" target="" data-discover="true"><span class="trim">Explore Opportunities</span><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="icon"><path d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"></path></svg></a></section><section class="bg-secondary/10"><h2 id="follow"><a class="contents text-current no-underline" href="/#follow" target="" data-discover="true"><hr/>Follow<hr/></a></h2><div class="grid grid-cols-[repeat(auto-fit,minmax(auto,--spacing(50)))] justify-center gap-4"><a href="https://www.instagram.com/3blue1brown" target="_blank" class="inline-flex max-w-full items-center justify-center gap-2 rounded-md font-sans text-balance no-underline [&amp;_p]:contents [&amp;_p]:leading-normal text-black hocus:bg-theme/15 hocus:text-theme min-h-12 min-w-12 p-3 text-lg justify-start" aria-label="Instagram"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256" class="icon"><path d="M128,80a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32